{
  "name": "phephim-community",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "ai": {
    "binding": "AI"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CHAT_ROOMS",
        "class_name": "ChatRoom"
      },
      {
        "name": "SUPPORT_ROOMS",
        "class_name": "SupportRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "ChatRoom"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "SupportRoom"
      ]
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "vars": {
    "TELEGRAM_CHANNEL_SYNC_ENABLED": "false",
    "CLOUDFLARE_WORKERS_AI_MODEL": "@cf/zai-org/glm-4.7-flash",
    "CLOUDFLARE_WORKERS_AI_FALLBACK": "@cf/qwen/qwen3-30b-a3b-fp8",
    "HUNG_CREATER_AUTO_REPLY": "true",
    "HUNG_CREATER_REPLY_PROBABILITY": "0.30",
    "HUNG_CREATER_ROOM_COOLDOWN_SECONDS": "120",
    "HUNG_CREATER_USER_COOLDOWN_SECONDS": "600",
    "HUNG_CREATER_MAX_REPLIES_PER_HOUR": "12",
    "COMMUNITY_ANTI_SPAM_ENABLED": "true",
    "COMMUNITY_ANTI_ADS_ENABLED": "true",
    "COMMUNITY_BLOCK_EXTERNAL_SOLICITATION": "true",
    "COMMUNITY_MAX_MESSAGES_10S": "5",
    "COMMUNITY_MAX_MESSAGES_60S": "20",
    "COMMUNITY_DUPLICATE_WINDOW_SECONDS": "60",
    "COMMUNITY_MODERATION_MAX_WARNINGS": "3",
    "COMMUNITY_MODERATION_BAN_HOURS": "24",
    "APP_ORIGIN": "https://phephim.vercel.app",
    "CATALOG_ORIGIN": "https://phephim.vercel.app",
    "COMMUNITY_CLEANUP_ONLY": "true"
  }
}
